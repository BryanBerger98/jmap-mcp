{
  "name": "jmap-mcp",
  "version": "0.1.0",
  "description": "Local MCP server exposing a Stalwart JMAP server (mail, calendar, contacts, files, sharing, Sieve) to an AI assistant, with a configurable write policy.",
  "keywords": [
    "mcp",
    "jmap",
    "stalwart",
    "email",
    "calendar",
    "caldav"
  ],
  "license": "MIT",
  "author": "Bryan Berger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BryanBerger98/jmap-mcp.git"
  },
  "homepage": "https://github.com/BryanBerger98/jmap-mcp#readme",
  "bugs": "https://github.com/BryanBerger98/jmap-mcp/issues",
  "type": "module",
  "bin": {
    "jmap-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
